{
	"name": "obsidian-reading-mode-highlighter",
	"version": "1.3.0",
	"description": "Highlight selected text in reading mode without visual transitions.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": ["obsidian", "plugin", "highlight", "reading-mode"],
	"author": "13byte",
	"license": "ISC",
	"devDependencies": {
		"@types/node": "^20.17.10",
		"@typescript-eslint/eslint-plugin": "^8.53.0",
		"@typescript-eslint/parser": "^8.53.0",
		"builtin-modules": "^4.0.0",
		"esbuild": "^0.24.2",
		"obsidian": "latest",
		"tslib": "^2.8.1",
		"typescript": "^5.7.2"
	}
}
